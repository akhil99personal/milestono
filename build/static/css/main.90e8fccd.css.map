/* Overall Page Styling */
.cards-page {
  font-family: "Poppins", sans-serif;
  background-color: var(--background-color);
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
}

.cards-page h1 {
  text-align: center;
  color: var(--primary-color); /* Deep red for headings */
  font-size: 2.5rem;
  margin-bottom: 40px;
  font-weight: bold;
}

.tab-button.active {
  color: var(--primary-color);
}

/* Card Design */
.cards-page-card-container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin: 20px 0;
}

.cards-page-card {
  background-color: var(--secondary-color);
  border: 0.5px solid lightgray;
  border-radius: 12px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  overflow: hidden;
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
  cursor: pointer;
}

.cards-page-card:hover {
  transform: scale(1.05);
  box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
}

.cards-page-card img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

.cards-page-card-title {
  padding: 15px;
  font-size: 1.2rem;
  color: var(--text-color); /* Black text for titles */
  text-align: center;
  font-weight: bold;
}

/*  */

.cards-page-card-container-in-homepage {
  display: flex;
  flex-direction: row;
  overflow: scroll;
  scrollbar-width: none;
  padding: 20px;
  margin-left: -20px;
  gap: 2.2rem;
}

.cards-page-card-container-in-homepage::-webkit-scrollbar {
  display: none;
}

.cards-page-card-in-homepage {
  background-color: var(--background-color); /* White card background */
  border: 0.5px solid lightgray; /* Black border */
  border-radius: 12px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  min-width: 31.5%;
  overflow: hidden;
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
  cursor: pointer;
}

/*  */

/* Modal Styling */
.cards-page-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6); /* Dark overlay */
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  animation: fadeIn 0.5s;
}

.cards-page-modal-content {
  display: flex;
  position: relative;
  flex: 1;
  background-color: var(--background-color); /* White modal */
  max-width: 800px;
  height: 400px;
  width: fit-content;
  border-radius: 15px;
  padding: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  text-align: center;
  animation: scaleIn 0.5s;
}

.cards-page-modal-content img {
  flex: 0.1;
  width: 50%;
  height: auto;
  border-radius: 10px;
  margin-bottom: 15px;
}

.cards-page-modal-content-div {
  margin: auto 0;
  margin-left: 1rem;
  text-align: left;
}

.cards-page-modal-content-div h2 {
  font-size: 1.8rem;
  color: var(--primary-color); /* Red title */
  margin-bottom: 10px;
}

.cards-page-modal-content-div p {
  font-size: 1rem;
  color: var(--text-color);
  line-height: 1.6;
}

.cards-page-modal-content-div p .status {
  color: #007bff !important;
}

.cards-page-modal-content-div button {
  background-color: var(--primary-color);
  color: var(--secondary-color);
  border: none;
  padding: 0.5rem 1.5rem;
  border-radius: 9px;
  margin-top: 15px;
  font-size: 1rem;
  box-shadow: 1px 2px 8px rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease-in-out;
}

.cards-page-see-more-button {
  font-size: 16px;
  color: var(--primary-color);
  background-color: transparent;
  /* text-decoration :underline; */
  white-space: nowrap;
  border: none;
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.3s ease-in-out;
  display: block;
}

.cards-page-see-more-button:hover {
  margin: -0.5rem;
  padding: 0.5rem;
  background-color: lightgrey;
  color: var(--primary-color);
}

.cards-page-modal-content-div button:hover {
  box-shadow: 1px 5px 20px rgb(0, 0, 0, 0.5);
}

.cards-page-close-button {
  position: absolute;
  top: 10px;
  right: 10px;
  background: none;
  border: none;
  font-size: 25px;
  font-weight: bold;
  color: var(--text-color);
  cursor: pointer;
  padding: 5px 10px;
  border-radius: 50%;
  z-index: 1000; /* Ensure the close button stays on top */
  transition: background-color 0.3s ease;
}

.cards-page-close-button:hover {
  background-color: rgba(0, 0, 0, 0.1);
}

/* Popup Styling */
.cards-page-modal-popup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: var(--background-color);
  padding: 20px;
  border-radius: 8px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
  width: 300px;
  z-index: 1001; /* Ensure small popup stays on top */
}

/* Close Popup Button */
.cards-page-modal-close-popup {
  position: absolute;
  top: 5px;
  right: 5px;
  font-size: 20px;
  font-weight: bold;
  color: var(--text-color);
  cursor: pointer;
}

/* Links in Popup */
.cards-page-modal-popup a {
  text-decoration: none;
  color: #007bff;
}

/* Pagination Styling */
.cards-page-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 50px;
  gap: 15px;
}

.cards-page-page-button,
.cards-page-page-number {
  background-color: var(--secondary-color); /* Light pink for buttons */
  border: 0.5px solid lightgray;
  border-radius: 0px;
  padding: 10px 15px;
  cursor: pointer;
  transition: background-color 0.3s ease;
  font-weight: 500;
  color: var(--primary-color); /* Red text for pagination */
}

.cards-page-page-button:hover,
.cards-page-page-number:hover {
  background-color: var(--primary-color); /* Red on hover */
  color: var(--secondary-color); /* White text */
}

.cards-page-page-number.active {
  background-color: var(--primary-color);
  color: var(--secondary-color);
  font-weight: bold;
}

.cards-page-page-button.disabled {
  background-color: var(--secondary-color);
  color: var(--primary-color);
  opacity: 0.5;
  cursor: not-allowed;
}

/* Animations */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes scaleIn {
  from {
    transform: scale(0.9);
  }
  to {
    transform: scale(1);
  }
}

/* Section Styling */
.cards-page-famous-places-section {
  background-color: #222; /* Keep Dark background */
  color: var(--secondary-color);
  padding: 3rem 1.5rem;
  text-align: center;
}

/* Title Styling */
.cards-page-section-title {
  font-size: 2.5rem;
  font-weight: bold;
  margin-bottom: 1rem;
  color: var(--secondary-color);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.cards-page-section-description {
  font-size: 1.2rem;
  margin-bottom: 2rem;
  color: var(--secondary-color); /* Slightly dimmed text */
  line-height: 1.6;
}

/* Column Layout */
.cards-page-places-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 2rem;
  margin-top: 2rem;
}

.cards-page-places-column {
  flex: 1 1 calc(25% - 1rem);
  min-width: 200px;
}

.cards-page-column-title {
  font-size: 1.5rem;
  font-weight: bold;
  margin-bottom: 1rem;
  border-bottom: 2px solid #555;
  padding-bottom: 0.5rem;
  /* text-align: center; keep if you want*/
  text-align: left;
}

/* List Styling */
.cards-page-places-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.cards-page-places-list li {
  /* text-align: center; keep if you want*/
  text-align: left;
  font-size: 1rem;
  margin: 0.5rem 0;
}

.cards-page-city-link {
  text-decoration: none;
  color: rgb(255, 255, 255); /* Vibrant orange */
  font-weight: 500;
  transition:
    color 0.3s ease,
    text-shadow 0.3s ease;
}

.cards-page-city-link:hover {
  color: var(--primary-color); /* White on hover */
}

/* Main container */
.enquiry-section {
  position: relative;
  width: 100%;
  height: 85vh;
  background-image: url("../../images/contactbanner.webp");
  background-size: cover;
  background-repeat: no-repeat;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: left;
  padding: 0 5rem;
}

.marquee-container {
  width: 100%;
  background-color: rgba(255, 0, 0, 0);
  padding: 8px 0;
}

.marquee-text {
  color: black;
  font-size: 18px;
  font-weight: bold;
}

/* Box styling */
.enquiry-box {
  width: 400px;
  padding: 25px 20px;
  padding-top: 50px;
  background: rgba(0, 0, 0, 0.6);
  border: 2px solid var(--primary-color);
  position: relative;
  color: var(--secondary-color);
}

/* Header styling */
.enquiry-header {
  position: absolute;
  top: 0px;
  left: 0;
  background-color: var(--primary-color);
  padding: 8px 15px;
  font-size: 16px;
  font-weight: bold;
  color: var(--secondary-color);
  text-transform: uppercase;
}

/* Form styling */
.enquiry-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* Input and Textarea styling */
.enquiry-input,
.enquiry-form select,
.enquiry-textarea {
  width: 100%;
  padding: 8px;
  background: transparent;
  border: none;
  border-bottom: 1px solid var(--secondary-color);
  font-size: 14px;
  color: var(--secondary-color);
  outline: none;
}

.enquiry-input::placeholder,
.enquiry-textarea::placeholder {
  color: rgba(255, 255, 255, 0.8);
  font-size: 14px;
}

/* Textarea styling */
.enquiry-textarea {
  height: 80px;
  resize: none;
  border: 1px solid var(--secondary-color);
  border-radius: 5px;
}

/* Dropdown styling */
.enquiry-form select {
  appearance: none;
  cursor: pointer;
  color: var(--secondary-color);
  border-bottom: 1px solid var(--secondary-color);
}

.enquiry-form select option {
  color: black;
  background-color: var(--secondary-color);
}

/* Button styling */
.enquiry-button {
  background-color: var(--primary-color);
  border: none;
  padding: 10px;
  font-size: 14px;
  font-weight: bold;
  color: var(--secondary-color);
  text-transform: uppercase;
  cursor: pointer;
  transition: 0.3s ease;
}

.enquiry-button:hover {
  background-color: var(--hover-color);
}

/* General Styles */
.listing-container {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.listing-card {
  display: flex;
  flex: 3;
  align-items: center;
  background-color: var(--secondary-color);
  border-radius: 10px;
  overflow: hidden;
  /* box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); */
  border: 2px solid lightgray;
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.listing-image {
  width: 140px;
  height: auto;
  background-color: var(--background-color);
  display: flex;
  justify-content: center;
  align-items: center;
}

.listing-image img {
  max-width: 100%;
  max-height: 100%;
  object-fit: cover;
}

.listing-content {
  flex: 1;
  flex-grow: 1;
  padding: 15px 20px;
}

.listing-title {
  font-size: 1.2rem;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 5px;
}

.listing-location {
  font-size: 0.9rem;
  color: var(--text-color);
  margin-bottom: 10px;
}

.listing-status {
  font-size: 0.95rem;
  color: #007bff;
  margin-bottom: 5px;
}

.listing-possession {
  font-size: 0.85rem;
  color: var(--text-color);
}

.listing-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-right: 20px;
}

.view-details-btn {
  background-color: #007bff;
  color: var(--secondary-color);
  border: none;
  padding: 8px 15px;
  border-radius: 5px;
  cursor: pointer;
  transition: background-color 0.3s;
}

.view-details-btn:hover {
  background-color: #0056b3;
}

/* Responsive Styles */
@media (max-width: 786px) {
  .enquiry-section {
    background-image: url("../../images/contactbannersedemo.jpg");
    padding: 0 2rem;
  }

  .enquiry-box {
    width: 100%;
  }

  .cards-pages-section-header-h2 {
    margin-left: 2rem;
  }

  .tabs.exp-proj-tabs {
    text-align: center;
  }

  .listing-card {
    flex: none;
    flex-direction: column;
    text-align: start;
    justify-content: start;
    align-items: start;
  }

  .listing-image {
    min-width: 100%;
    height: 50%;
    object-fit: fill;
  }

  .listing-title {
    font-size: 2rem;
  }

  .listing-location {
    font-size: 1.4rem;
  }

  .listing-status {
    font-size: 1.6rem;
    margin-top: -2rem;
  }

  .listing-possession {
    font-size: 1.5rem;
  }

  .listing-actions {
    text-align: center;
    justify-content: center;
    margin: 10px 20px;
  }

  .cards-page-places-container {
    flex-wrap: wrap;
    gap: 2rem 0;
  }

  .cards-page-places-column {
    min-width: 50%;
    max-width: 50%;
  }

  .cards-page-card-container {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cards-page-card-container-in-homepage {
    display: flex;
    flex-direction: row;
    overflow: scroll;
    padding: 0 20px;
    margin-left: 0px;
    gap: 2rem;
  }

  .cards-page-card-in-homepage {
    background-color: var(--background-color); /* White card background */
    border: 0.5px solid lightgray; /* Black border */
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    min-width: 75%;
    overflow: hidden;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    cursor: pointer;
  }

  .explore-projects-heading {
    padding-left: 2rem;
  }

  .cards-page-modal-content {
    max-width: none;
    width: 90%;
    height: auto;
    flex: none;
    flex-direction: column;
  }

  .cards-page-modal-content img {
    flex: none;
    width: 80%;
    margin: 0 auto;
    height: 50%;
    border-radius: 10px;
    margin-bottom: 15px;
  }

  .cards-page-column-title {
    font-size: 1.8rem;
  }

  .cards-page-places-list li {
    font-size: 1.5rem;
    margin: 0.5rem 0;
  }
}
